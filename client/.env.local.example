# Copy to .env for local dev:  cp .env.local.example .env   (PowerShell: Copy-Item .env.local.example .env)
# Vite loads .env, .env.local, .env.[mode] — do not commit real .env

VITE_NODE_ENV=development
VITE_BASE_ENDPOINT=http://localhost:4000
VITE_CLIENT_ENDPOINT=http://localhost:3000
VITE_STRIPE_KEY=
VITE_ELASTIC_APM_SERVER=http://localhost:8200
