# ==============================================
# ITHUST CLIENT ENVIRONMENT
# ==============================================
# Copy to .env for local frontend development.
# Keep comments for readability; keep values environment-specific.

# ==============================================
# RUNTIME CONFIGURATION
# ==============================================
VITE_NODE_ENV=development

# ==============================================
# CLIENT CONFIGURATION
# ==============================================
# Public Vite variables are bundled into the browser build.
# Do not put private secrets in variables prefixed with VITE_.
VITE_BASE_ENDPOINT=http://localhost:4000
VITE_CLIENT_ENDPOINT=http://localhost:3000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# ==============================================
# OBSERVABILITY CONFIGURATION
# ==============================================
# Elasticsearch powers logging/search; APM is enabled only when ENABLE_APM=1.
VITE_ELASTIC_APM_SERVER=http://localhost:8200
