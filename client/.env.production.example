# ==============================================
# ITHUST CLIENT ENVIRONMENT
# ==============================================
# Production frontend template. Public Vite values are bundled at build time.
# Defaults support ithust.shop as frontend and ithust.store as API/realtime gateway.
# Keep comments for readability; keep values environment-specific.

# ==============================================
# RUNTIME CONFIGURATION
# ==============================================
VITE_NODE_ENV=production

# ==============================================
# CLIENT CONFIGURATION
# ==============================================
# Public Vite variables are bundled into the browser build.
# Do not put private secrets in variables prefixed with VITE_.
VITE_BASE_ENDPOINT=https://ithust.store
VITE_CLIENT_ENDPOINT=https://ithust.shop
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# ==============================================
# OBSERVABILITY CONFIGURATION
# ==============================================
# Leave empty to disable browser Elastic APM.
VITE_ELASTIC_APM_SERVER=

# ==============================================
# ADMIN CONFIGURATION
# ==============================================
# Username of the admin account (used to identify admin conversations in seller inbox)
VITE_ADMIN_USERNAME=admin
