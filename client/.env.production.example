# ==============================================
# ITHUST CLIENT ENVIRONMENT
# ==============================================
# Production frontend template. Inject real values through CI/hosting secrets.
# Keep comments for readability; keep values environment-specific.

# ==============================================
# RUNTIME CONFIGURATION
# ==============================================
VITE_NODE_ENV=production

# ==============================================
# CLIENT CONFIGURATION
# ==============================================
# Public Vite variables are bundled into the browser build.
# Do not put private secrets in variables prefixed with VITE_.
VITE_BASE_ENDPOINT=https://YOUR_DOMAIN.com
VITE_CLIENT_ENDPOINT=https://YOUR_DOMAIN.com

# ==============================================
# OBSERVABILITY CONFIGURATION
# ==============================================
# Elasticsearch powers logging/search; APM is enabled only when ENABLE_APM=1.
VITE_ELASTIC_APM_SERVER=https://apm.YOUR_DOMAIN.com
