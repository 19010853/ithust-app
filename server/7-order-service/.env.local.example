# ==============================================
# ITHUST ORDER-SERVICE ENVIRONMENT
# ==============================================
# Copy to .env for local service development.
# Keep comments for readability; keep values environment-specific.

# ==============================================
# RUNTIME CONFIGURATION
# ==============================================
NODE_ENV=development
ENABLE_APM=0

# ==============================================
# SERVICE URLS
# ==============================================
# Internal service URLs should point to localhost for local dev and cluster DNS in production.
CLIENT_URL=http://localhost:3000
API_GATEWAY_URL=http://localhost:4000

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# Use localhost/127.0.0.1 for host development; use service DNS inside Docker/Kubernetes.
DATABASE_URL=mongodb://127.0.0.1:27017/ithust-order

# ==============================================
# AUTHENTICATION AND SECURITY
# ==============================================
# Replace all placeholder tokens before deploying.
# Keep production secrets in CI/Kubernetes Secrets, not in committed files.
JWT_TOKEN=dev-jwt-token-change-me
GATEWAY_JWT_TOKEN=dev-gateway-jwt-change-me

# ==============================================
# PLATFORM OWNER CONFIGURATION
# ==============================================
# Administrative owner account/contact used by auth, order, and withdrawal flows.
PLATFORM_OWNER_EMAIL=admin@example.com

# ==============================================
# MESSAGE BROKER AND CACHE
# ==============================================
# RabbitMQ handles async events; Redis handles cache/session/socket coordination.
RABBITMQ_ENDPOINT=amqp://ithust:ithustpass@127.0.0.1:5672

# ==============================================
# PAYMENT CONFIGURATION
# ==============================================
# SePay/VietQR values control bank transfer QR and webhook reconciliation.
# Use test mode locally and live mode only in production.
PLATFORM_BANK_ID=MBBank
PLATFORM_BANK_ACCOUNT=0123456789
SEPAY_MODE=test
USD_TO_VND_RATE_API_URL=https://api.frankfurter.dev/v2/rate/USD/VND
USD_TO_VND_RATE_FALLBACK=25000

# ==============================================
# CLOUDINARY CONFIGURATION
# ==============================================
# Cloudinary credentials are used for media/file uploads.
CLOUD_NAME=your-cloudinary-cloud-name
CLOUD_API_KEY=your-cloudinary-api-key
CLOUD_API_SECRET=your-cloudinary-api-secret

# ==============================================
# OBSERVABILITY CONFIGURATION
# ==============================================
# Elasticsearch powers logging/search; APM is enabled only when ENABLE_APM=1.
ELASTIC_SEARCH_URL=http://localhost:9200
ELASTIC_APM_SERVER_URL=http://localhost:8200
ELASTIC_APM_SECRET_TOKEN=
