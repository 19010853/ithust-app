def namespace = "production"
def serviceName = "ithust-review"
def service = "ITHust Reviews"
fn = null

pipeline {
    agent {
        label 'Jenkins-Agent'
    }

    tools {
        nodejs "NodeJS"
        dockerTool "Docker"
    }

    environment {
        // This automatically sets $DOCKER_CREDENTIALS_USR and $DOCKER_CREDENTIALS_PSW
        DOCKER_CREDENTIALS = credentials('dockerhub')
        IMAGE_NAME = "minhkhoi779/ithust-review"
        IMAGE_TAG = "stable-${BUILD_NUMBER}"
    }

    stages {
        stage("Cleanup Workspace") {
            steps {
                cleanWs()
            }
        }

        stage("Prepare Environment") {
            steps {
                // Clone the root git repository
                git branch: 'main', credentialsId: 'github', url: 'https://github.com/19010853/ithust-app.git'
                script {
                    // Load shared pipeline helpers from repository workspace
                    fn = load 'server/functions.groovy'
                }
            }
        }

        stage("Install Dependencies") {
            steps {
                // Change into the service directory
                dir('server/8-review-service') {
                    sh 'npm install --legacy-peer-deps'
                }
            }
        }

        stage("Lint Check") {
            steps {
                dir('server/8-review-service') {
                    sh 'npm run lint:check'
                }
            }
        }

        stage("Code Format Check") {
            steps {
                dir('server/8-review-service') {
                    sh 'npm run prettier:check'
                }
            }
        }

        stage("Unit Test") {
            steps {
                dir('server/8-review-service') {
                    sh 'npm run test'
                }
            }
        }

        stage("Build and Push") {
            steps {
                dir('server/8-review-service') {
                    // Use the correct variables generated by the credentials() binding. 
                    // Using --password-stdin is the recommended Docker best practice to hide warnings.
                    sh 'echo "$DOCKER_CREDENTIALS_PSW" | docker login -u "$DOCKER_CREDENTIALS_USR" --password-stdin'
                    
                    sh "docker build -t $IMAGE_NAME ."
                    sh "docker tag $IMAGE_NAME $IMAGE_NAME:$IMAGE_TAG"
                    sh "docker tag $IMAGE_NAME $IMAGE_NAME:stable"
                    
                    sh "docker push $IMAGE_NAME:$IMAGE_TAG"
                    sh "docker push $IMAGE_NAME:stable"
                }
            }
        }

        stage("Clean Artifacts") {
            steps {
                sh "docker rmi $IMAGE_NAME:$IMAGE_TAG"
                sh "docker rmi $IMAGE_NAME:stable"
                sh "docker rmi $IMAGE_NAME" // Cleans up the base tag created by `docker build`
            }
        }
    }
}