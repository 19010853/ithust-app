// =============================================================================
// ITHust — Review service (Declarative Pipeline)
// =============================================================================
// Yêu cầu Jenkins:
//   - Plugins: Pipeline, Workspace Cleanup (cleanWs), Credentials, Kubernetes CLI (kubectl trên agent)
//   - Credentials: github, dockerhub, jenkins-slack-webhook (Secret text)
//   - github-npm-token (Secret text): GitHub PAT có quyền read:packages (tải @19010853/ithust-shared từ GitHub Packages)
//   - Tuỳ chọn: Secret file kubeconfig (id khớp kubeconfigCredentialId) để restart pod trên K8s
// =============================================================================

// --- Tham số triển khai (đổi theo service khác nếu cần) ---
def namespace = 'production'
def serviceName = 'ithust-review'
def service = 'ITHust Reviews'
def slackChannel = 'ithust-jenkins'

// Jenkins credential id kiểu "Secret file" chứa nội dung kubeconfig (kubectl config view --raw)
// Đặt '' để bỏ qua stage restart pod (build vẫn chạy bình thường)
def kubeconfigCredentialId = 'kubeconfig'

def groovyMethods
def m1 = System.currentTimeMillis()

pipeline {
    agent {
        label 'Jenkins-Agent'
    }

    tools {
        nodejs 'NodeJS'
        dockerTool 'Docker'
    }

    environment {
        // credentials('dockerhub') tạo thêm DOCKER_CREDENTIALS_USR / DOCKER_CREDENTIALS_PSW
        DOCKER_CREDENTIALS = credentials('dockerhub')
        IMAGE_NAME = 'minhkhoi779/ithust-review'
        IMAGE_TAG = "stable-${BUILD_NUMBER}"
        SLACK_WEBHOOK_URL = credentials('jenkins-slack-webhook')
    }

    stages {
        // ---------------------------------------------------------------------
        // Dọn workspace trước khi clone (tránh file cũ làm bẩn build)
        // ---------------------------------------------------------------------
        stage('Cleanup Workspace') {
            steps {
                cleanWs()
            }
        }

        // ---------------------------------------------------------------------
        // Clone monorepo + load helper Groovy dùng chung (Slack, kubectl, duration…)
        // ---------------------------------------------------------------------
        stage('Prepare Environment') {
            steps {
        // Sử dụng checkout scm với Shallow Clone (depth: 1)
        checkout([
            $class: 'GitSCM', 
            branches: [[name: '*/main']], 
            extensions: [[$class: 'CloneOption', depth: 1, noTags: true, reference: '', shallow: true]], 
            userRemoteConfigs: [[credentialsId: 'github', url: 'https://github.com/19010853/ithust-app.git']]
        ])
        
        script {
            if (!fileExists('server/functions.groovy')) {
                error 'Thiếu server/functions.groovy — commit và push lên GitHub.'
            }
            groovyMethods = load 'server/functions.groovy'
        }
    }
        }

        // ---------------------------------------------------------------------
        // Build & kiểm tra mã nguồn (chạy trong thư mục service)
        // ---------------------------------------------------------------------
        stage('Install Dependencies') {
            steps {
                withCredentials([string(credentialsId: 'github-npm-token', variable: 'NPM_TOKEN')]) {
                    dir('server/8-review-service') {
                        // Forcefully remove the bad line from .npmrc if it exists
                        sh 'sed -i "/always-auth/d" .npmrc || true'
                        sh 'npm install --legacy-peer-deps'
                    }
                }
            }
        }

        stage('Lint Check') {
            steps {
                dir('server/8-review-service') {
                    sh 'npm run lint:check'
                }
            }
        }

        stage('Code Format Check') {
            steps {
                dir('server/8-review-service') {
                    sh 'npm run prettier:check'
                }
            }
        }

        stage('Unit Test') {
            steps {
                dir('server/8-review-service') {
                    sh 'npm run test'
                }
            }
        }

        // ---------------------------------------------------------------------
        // Docker: build image cục bộ rồi push lên Docker Hub (tag build + stable)
        // ---------------------------------------------------------------------
        stage('Build and Push') {
            steps {
                withCredentials([string(credentialsId: 'github-npm-token', variable: 'NPM_TOKEN')]) {
                    dir('server/8-review-service') {
                        sh '''
                            set +x
                            docker login -u "$DOCKER_CREDENTIALS_USR" -p "$DOCKER_CREDENTIALS_PSW"
                        '''
                        // Dockerfile dùng ARG NPM_TOKEN cho npm ci (GitHub Packages)
                        sh "docker build --build-arg NPM_TOKEN=\$NPM_TOKEN -t ${IMAGE_NAME} ."
                        sh "docker tag ${IMAGE_NAME} ${IMAGE_NAME}:${IMAGE_TAG}"
                        sh "docker tag ${IMAGE_NAME} ${IMAGE_NAME}:stable"
                        sh "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
                        sh "docker push ${IMAGE_NAME}:stable"
                    }
                }
            }
        }

        stage("Create New Pods") {
            steps {
                withKubeCredentials(kubectlCredentials: [[caCertificate: '', clusterName: 'minikube', contextName: 'minikube', credentialsId: 'jenkins-k8s-token', namespace: '', serverUrl: 'https://172.25.241.111:8443']]) {
                    script {
                        def pods = groovyMethods.findPodsFromName("${namespace}", "${serviceName}")
                        for (podName in pods) {
                            sh """
                                kubectl delete -n ${namespace} pod ${podName}
                                sleep 10s
                            """
                        }
                    }
                }
            }
        }
    }
    
    post {
        success {
            script {
                if (groovyMethods == null) {
                    echo 'post/success: groovyMethods chưa được load, bỏ qua notifySlack.'
                    return
                }
                def m2 = System.currentTimeMillis()
                def durTime = groovyMethods.durationTime(m1, m2)
                def author = groovyMethods.readCommitAuthor()
                groovyMethods.notifySlack("", slackChannel, [
                    [
                        title: "BUILD SUCCEEDED: ${service} Service with build number ${env.BUILD_NUMBER}",
                        title_link: "${env.BUILD_URL}",
                        color: "good",
                        text: "Created by: ${author}",
                        "mrkdwn_in": ["fields"],
                        fields: [
                            [
                                title: "Duration Time",
                                value: "${durTime}",
                                short: true
                            ],
                            [
                                title: "Stage Name",
                                value: "Production",
                                short: true
                            ],
                        ]
                    ]
                ])
            }
        }
        failure {
            script {
                if (groovyMethods == null) {
                    echo 'post/failure: groovyMethods chưa được load, bỏ qua notifySlack.'
                    return
                }
                def m2 = System.currentTimeMillis()
                def durTime = groovyMethods.durationTime(m1, m2)
                def author = groovyMethods.readCommitAuthor()
                groovyMethods.notifySlack("", slackChannel, [
                    [
                        title: "BUILD FAILED: ${service} Service with build number ${env.BUILD_NUMBER}",
                        title_link: "${env.BUILD_URL}",
                        color: "danger",
                        text: "Created by: ${author}",
                        "mrkdwn_in": ["fields"],
                        fields: [
                            [
                                title: "Duration Time",
                                value: "${durTime}",
                                short: true
                            ],
                            [
                                title: "Stage Name",
                                value: "Production",
                                short: true
                            ],
                        ]
                    ]
                ])
            }
        }
    }
}