# ==============================================
# ITHUST NOTIFICATION-SERVICE ENVIRONMENT
# ==============================================
# Production service template. Inject real values via CI/Kubernetes Secrets.
# Keep comments for readability; keep values environment-specific.

# ==============================================
# RUNTIME CONFIGURATION
# ==============================================
NODE_ENV=production

# ==============================================
# SERVICE URLS
# ==============================================
# Internal service URLs should point to localhost for local dev and cluster DNS in production.
CLIENT_URL=https://YOUR_DOMAIN.com

# ==============================================
# MESSAGE BROKER AND CACHE
# ==============================================
# RabbitMQ handles async events; Redis handles cache/session/socket coordination.
RABBITMQ_ENDPOINT=amqp://USER:PASS@rabbitmq.production.svc.cluster.local:5672

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
# Brevo SMTP relay for production transactional email only.
# Local development and tests should use Ethereal credentials from https://ethereal.email/create.
# Use the Brevo SMTP login and SMTP key, not a Brevo REST API key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=REPLACE_WITH_BREVO_SMTP_LOGIN
SMTP_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY
SENDER_NAME=ITHust App
SENDER_EMAIL=no-reply@YOUR_DOMAIN.com
SENDER_EMAIL_PASSWORD=legacy-placeholder

# ==============================================
# OBSERVABILITY CONFIGURATION
# ==============================================
# Elasticsearch powers logging/search; APM is enabled only when ENABLE_APM=1.
ELASTIC_SEARCH_URL=http://ithust-elastic.production.svc.cluster.local:9200
