# ==============================================
# ITHUST NOTIFICATION-SERVICE ENVIRONMENT
# ==============================================
# Copy to .env for local service development.
# Keep comments for readability; keep values environment-specific.

# ==============================================
# RUNTIME CONFIGURATION
# ==============================================
NODE_ENV=development

# ==============================================
# SERVICE URLS
# ==============================================
# Internal service URLs should point to localhost for local dev and cluster DNS in production.
CLIENT_URL=http://localhost:3000

# ==============================================
# MESSAGE BROKER AND CACHE
# ==============================================
# RabbitMQ handles async events; Redis handles cache/session/socket coordination.
RABBITMQ_ENDPOINT=amqp://ithust:ithustpass@127.0.0.1:5672

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
# Local/test SMTP only. Create disposable Ethereal credentials at https://ethereal.email/create. Do not use Brevo in local development.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=REPLACE_WITH_ETHEREAL_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_ETHEREAL_SMTP_PASSWORD
SENDER_NAME=ITHust App
SENDER_EMAIL=REPLACE_WITH_ETHEREAL_SMTP_USER
SENDER_EMAIL_PASSWORD=legacy-placeholder

# ==============================================
# OBSERVABILITY CONFIGURATION
# ==============================================
# Elasticsearch powers logging/search; APM is enabled only when ENABLE_APM=1.
ELASTIC_SEARCH_URL=http://localhost:9200
