# Kubernetes / cloud — inject via Secrets / CI; do not commit filled .env

NODE_ENV=production
ENABLE_APM=1
ELASTIC_APM_SERVER_URL=https://apm.YOUR_DOMAIN.com
ELASTIC_APM_SECRET_TOKEN=REPLACE_APM_SECRET

JWT_TOKEN=REPLACE_ME
GATEWAY_JWT_TOKEN=REPLACE_ME
SECRET_KEY_ONE=REPLACE_ME
SECRET_KEY_TWO=REPLACE_ME

CLIENT_URL=https://YOUR_DOMAIN.com
AUTH_BASE_URL=http://ithust-auth.production.svc.cluster.local:4002
USERS_BASE_URL=http://ithust-users.production.svc.cluster.local:4003
GIG_BASE_URL=http://ithust-gig.production.svc.cluster.local:4004
MESSAGE_BASE_URL=http://ithust-chat.production.svc.cluster.local:4005
ORDER_BASE_URL=http://ithust-order.production.svc.cluster.local:4006
REVIEW_BASE_URL=http://ithust-review.production.svc.cluster.local:4007

REDIS_HOST=redis://ithust-redis.production.svc.cluster.local:6379
ELASTIC_SEARCH_URL=http://ithust-elastic.production.svc.cluster.local:9200
