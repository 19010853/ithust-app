# Copy to .env (not committed). Matches volumes/docker-compose.yaml when services run on localhost.
# Infra: Redis 6379, Elasticsearch http://localhost:9200, APM http://localhost:8200

NODE_ENV=development
ENABLE_APM=0
ELASTIC_APM_SERVER_URL=http://localhost:8200
ELASTIC_APM_SECRET_TOKEN=

JWT_TOKEN=dev-jwt-token-change-me
GATEWAY_JWT_TOKEN=dev-gateway-jwt-change-me
SECRET_KEY_ONE=dev-secret-key-one-change-me
SECRET_KEY_TWO=dev-secret-key-two-change-me

CLIENT_URL=http://localhost:3000
AUTH_BASE_URL=http://localhost:4002
USERS_BASE_URL=http://localhost:4003
GIG_BASE_URL=http://localhost:4004
MESSAGE_BASE_URL=http://localhost:4005
ORDER_BASE_URL=http://localhost:4006
REVIEW_BASE_URL=http://localhost:4007

REDIS_HOST=redis://127.0.0.1:6379
ELASTIC_SEARCH_URL=http://localhost:9200
